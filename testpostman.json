{
"name": "7. GET /stats — все хиты за период",
"event": [
{
"listen": "test",
"script": {
"exec": [
"pm.test('Статус 200', function() {",
" pm.response.to.have.status(200);",
"});",
"pm.test('Возвращает массив', function() {",
" const json = pm.response.json();",
" pm.expect(json).to.be.an('array');",
" pm.expect(json.length).to.be.above(0);",
"});",
"pm.test('Содержит поля app, uri, hits', function() {",
" const json = pm.response.json();",
" pm.expect(json[0]).to.have.property('app');",
" pm.expect(json[0]).to.have.property('uri');",
" pm.expect(json[0]).to.have.property('hits');",
"});",
"pm.test('Отсортировано по hits DESC', function() {",
" const json = pm.response.json();",
" if (json.length > 1) {",
" pm.expect(json[0].hits).to.be.at.least(json[1].hits);",
" }",
"});"
]
}
}
],
"request": {
"method": "GET",
"url": {
"raw": "http://localhost:9090/stats?start=2020-01-01 00:00:00&end=2030-01-01 00:00:00",
"host": ["localhost"],
"port": "9090",
"path": ["stats"],
"query": [
{ "key": "start", "value": "2020-01-01 00:00:00" },
{ "key": "end", "value": "2030-01-01 00:00:00" }
]
},
"description": "Получаем всю статистику — /events/1 должен быть первым (больше хитов)"
}
},
{
"name": "8. GET /stats — только уникальные IP (unique=true)",
"event": [
{
"listen": "test",
"script": {
"exec": [
"pm.test('Статус 200', function() {",
" pm.response.to.have.status(200);",
"});",
"pm.test('/events/1 имеет 2 уникальных ip', function() {",
" const json = pm.response.json();",
" const event1 = json.find(x => x.uri === '/events/1');",
" pm.expect(event1).to.exist;",
" pm.expect(event1.hits).to.eql(2);",
"});"
]
}
}
],
"request": {
"method": "GET",
"url": {
"raw": "http://localhost:9090/stats?start=2020-01-01 00:00:00&end=2030-01-01 00:00:00&unique=true",
"host": ["localhost"],
"port": "9090",
"path": ["stats"],
"query": [
{ "key": "start", "value": "2020-01-01 00:00:00" },
{ "key": "end", "value": "2030-01-01 00:00:00" },
{ "key": "unique", "value": "true" }
]
},
"description": "Запросы 2 и 4 с одного ip — должно считаться как 2 уникальных (ip1 и ip2)"
}
},
