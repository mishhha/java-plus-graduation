"item": [
{
"name": "1. Health Check",
"event": [
{
"listen": "test",
"script": {
"exec": [
"pm.test('Сервис запущен', function() {",
" pm.response.to.have.status(200);",
" const json = pm.response.json();",
" pm.expect(json.status).to.eql('UP');",
"});"
]
}
}
],
"request": {
"method": "GET",
"url": "http://localhost:9090/actuator/health",
"description": "Проверяем что сервис запущен и работает"
}
},
